<Window x:Class="Practiceforunstd2.Reg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practiceforunstd2"
        mc:Ignorable="d"
       
        Title="Reg" Height="550" Background="#6C63FF" Width="400">
    <!--<Window.Background>
        <ImageBrush ImageSource="/image/Bg.jpg" Stretch="UniformToFill" ></ImageBrush>
    </Window.Background>-->
    <Window.Resources>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White" ></Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White" ></Setter>
        </Style>

        <!-- Button yle St-->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FF6584"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Blue"></Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Border Width="320"
                Background="Azure"
                Padding="25"
                CornerRadius="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Register"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Name"/>
                <TextBox Name="txtname"/>

                <TextBlock Text="Username"/>
                <TextBox Name="txtusername"/>

                <TextBlock Text="Password"/>
                <PasswordBox Name="txtpassword"/>

                <TextBlock Text="Confirm Password"/>
                <PasswordBox Name="txtcnmpass"/>

                <Button Content="Login"
                        Margin="0,10,0,0"
                        Click="Button_Click_1"/>
            </StackPanel>

        </Border>

    </Grid>
</Window>

